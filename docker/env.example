# =============================================================================
# Cloud Secrets Manager - Environment Variables
# =============================================================================
# Copy to .env.local:  cp env.example .env.local
# Then fill in the REQUIRED values below
# =============================================================================

# =============================================================================
# REQUIRED - Application will NOT start without these
# =============================================================================

# JWT Secret - Used for signing authentication tokens
# Generate with: openssl rand -hex 32
# Minimum 32 characters required
JWT_SECRET=

# AES Encryption Key - Used for encrypting secrets at rest
# Generate with: openssl rand -base64 24 | head -c 32
# MUST be exactly 32 characters for AES-256
ENCRYPTION_KEY=

# Firebase / Google Identity - Required for authentication
# Get these from Firebase Console > Project Settings > General
GOOGLE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Service account file path (download from Firebase Console > Service Accounts)
GOOGLE_SERVICE_ACCOUNT_PATH=infrastructure/gcp/keys/firebase-admin-key.json

# =============================================================================
# OPTIONAL - Have sensible defaults, customize as needed
# =============================================================================

# -----------------------------------------------------------------------------
# Database (defaults work for Docker Compose)
# -----------------------------------------------------------------------------
POSTGRES_DB=csm
POSTGRES_USER=csm
POSTGRES_PASSWORD=csm

# -----------------------------------------------------------------------------
# Google Cloud Platform
# -----------------------------------------------------------------------------
# Required for Pub/Sub event messaging (optional for local development)
GCP_PROJECT_ID=

# -----------------------------------------------------------------------------
# Email Notifications (SendGrid)
# -----------------------------------------------------------------------------
# Sign up at https://sendgrid.com (free: 100 emails/day)
# Leave EMAIL_ENABLED=false to skip email setup
EMAIL_ENABLED=false
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=noreply@cloudsecrets.com
EMAIL_FROM_NAME=Cloud Secrets Manager

# -----------------------------------------------------------------------------
# Service URLs (defaults work for Docker Compose)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
VITE_NOTIFICATION_SERVICE_URL=http://localhost:8082
AUDIT_SERVICE_URL=http://localhost:8081
NOTIFICATION_SERVICE_URL=http://localhost:8082

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
GOOGLE_IDENTITY_ENABLED=true

# =============================================================================
# Cloud Run Deployment - Additional secrets needed in GCP Secret Manager
# =============================================================================
# These are NOT needed for local development, only for Cloud Run:
#
# csm-jwt-secret           - Same as JWT_SECRET
# csm-aes-key              - Same as ENCRYPTION_KEY  
# csm-firebase-admin-key   - Firebase service account JSON
# csm-firebase-api-key     - Firebase API key
# csm-firebase-app-id      - Firebase App ID
# csm-firebase-messaging-sender-id - Firebase Messaging Sender ID
# csm-audit-api-key        - API key for audit service authentication
# csm-sendgrid-api-key     - SendGrid API key (if using email)
#
# Create secrets with:
#   gcloud secrets create <secret-name> --data-file=- <<< "value"
# =============================================================================
